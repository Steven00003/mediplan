rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function esCuidadorDelPaciente(pacienteId) {
      return isAuthenticated()
          && get(/databases/$(database)/documents/pacientes/$(pacienteId)).data.cuidadorId == request.auth.uid;
    }

    function esDispositivoVinculado(pacienteId) {
      return isAuthenticated()
          && get(/databases/$(database)/documents/pacientes/$(pacienteId)).data.dispositivoVinculadoId == request.auth.uid;
    }

    function estaLibre(dispositivo) {
      return dispositivo == null || dispositivo == '';
    }

    function vinculoVigenteDelPaciente(pacienteId, codigo) {
      let vinculo = get(/databases/$(database)/documents/vinculos/$(codigo));
      let expiraEn = vinculo.data.get('expiraEn', null);
      return vinculo.data.pacienteId == pacienteId
          && (expiraEn == null || expiraEn > request.time);
    }

    // Único mapa que el celular del paciente puede escribir en su documento.
    // Se validan las claves exactas, el timestamp del servidor y los tipos/tamaños
    // para que el dispositivo no pueda modificar la ficha ni los vínculos.
    function estadoDispositivoValido() {
      let estado = request.resource.data.get('estadoDispositivo', null);
      return estado is map
          && estado.keys().hasAll([
               'ultimaSincronizacion',
               'alarmasProgramadas',
               'notificacionesPermitidas',
               'bateriaSinRestricciones',
               'versionAndroid',
               'fabricante',
               'versionApp'
             ])
          && estado.keys().hasOnly([
               'ultimaSincronizacion',
               'alarmasProgramadas',
               'notificacionesPermitidas',
               'bateriaSinRestricciones',
               'versionAndroid',
               'fabricante',
               'versionApp'
             ])
          && estado.get('ultimaSincronizacion', null) == request.time
          && estado.get('alarmasProgramadas', -1) is int
          && estado.get('alarmasProgramadas', -1) >= 0
          && estado.get('alarmasProgramadas', -1) <= 10000
          && estado.get('notificacionesPermitidas', null) is bool
          && estado.get('bateriaSinRestricciones', null) is bool
          && estado.get('versionAndroid', -1) is int
          && estado.get('versionAndroid', -1) >= 0
          && estado.get('versionAndroid', -1) <= 100
          && estado.get('fabricante', null) is string
          && estado.get('fabricante', '').size() <= 40
          && estado.get('versionApp', null) is string
          && estado.get('versionApp', '').size() > 0
          && estado.get('versionApp', '').size() <= 40;
    }

    match /usuarios/{uid} {
      allow read, create, update: if isAuthenticated() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /pacientes/{pacienteId} {
      allow read: if isAuthenticated()
              && (request.auth.uid == resource.data.cuidadorId
                  || request.auth.uid == resource.data.dispositivoVinculadoId);
      allow create: if isAuthenticated()
                    && request.resource.data.cuidadorId == request.auth.uid
                    && request.resource.data.codigoVinculacion != null
                    && request.resource.data.nombre != null;
      allow update: if isAuthenticated() && (
          request.auth.uid == resource.data.cuidadorId
          ||
          (request.resource.data.dispositivoVinculadoId == request.auth.uid
           && estaLibre(resource.data.dispositivoVinculadoId)
           && request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly(['dispositivoVinculadoId'])
           && vinculoVigenteDelPaciente(
                pacienteId, resource.data.codigoVinculacion))
          ||
          (esDispositivoVinculado(pacienteId)
           && request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly(['estadoDispositivo'])
           && estadoDispositivoValido())
      );
      allow delete: if isAuthenticated()
                    && request.auth.uid == resource.data.cuidadorId;
    }

    match /tratamientos/{id} {
      allow read: if esCuidadorDelPaciente(resource.data.pacienteId)
                  || esDispositivoVinculado(resource.data.pacienteId);
      // El paciente solo puede escribir el campo del aviso de 5 días sin
      // tomas. El cuidador conserva el control total del tratamiento.
      allow update: if esCuidadorDelPaciente(resource.data.pacienteId)
                    || (esDispositivoVinculado(resource.data.pacienteId)
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(['ultimoAvisoSinTomas']));
      allow create: if esCuidadorDelPaciente(request.resource.data.pacienteId);
      allow delete: if esCuidadorDelPaciente(resource.data.pacienteId);
    }

    match /registrosToma/{id} {
      allow read: if esCuidadorDelPaciente(resource.data.pacienteId)
                  || esDispositivoVinculado(resource.data.pacienteId);
      // El paciente solo crea su registro. Confirmar y olvidar compiten por el
      // mismo id determinista; si el documento ya existe, un `set()` es un
      // update y debe quedar rechazado. El cuidador conserva la corrección.
      allow create: if esCuidadorDelPaciente(request.resource.data.pacienteId)
                    || esDispositivoVinculado(request.resource.data.pacienteId);
      allow update, delete: if esCuidadorDelPaciente(resource.data.pacienteId);
    }

    match /vinculos/{codigo} {
      // `get` (no `read`): el paciente resuelve un código por ID, pero nadie
      // puede listar toda la colección.
      allow get: if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.pacienteId != null
                    && request.resource.data.expiraEn is timestamp
                    && !exists(/databases/$(database)/documents/vinculos/$(codigo))
                    && esCuidadorDelPaciente(request.resource.data.pacienteId);
      // Reescribir el mismo vínculo (p. ej. al desvincular) sí; repuntarlo a
      // otro paciente o tocar el de otro cuidador, no.
      allow update: if isAuthenticated()
                    && resource.data.pacienteId != null
                    && request.resource.data.pacienteId == resource.data.pacienteId
                    && esCuidadorDelPaciente(resource.data.pacienteId);
      allow delete: if isAuthenticated()
                    && resource.data.pacienteId != null
                    && esCuidadorDelPaciente(resource.data.pacienteId);
    }
  }
}
